<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/bg" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="سعدون الشاطر" android:textColor="@color/text" android:textSize="30sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="SADOUN AL-SHATER • GUARDIAN" android:textColor="@color/accent" android:gravity="center" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="● متصل — الحارس متوقف" android:textColor="@color/accent" android:textSize="20sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/talk" android:text="🎙️ تحدث مع سعدون" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/guardian" android:text="🛡️ تشغيل وضع الحارس" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/sos" android:text="🆘 SOS تجريبي" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/tool" android:text="🛠️ اختبار طلب أداة" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/message" android:text="سعدون: معك يا عبدالناصر. هذه نسخة Android أولية للاختبار." android:textColor="@color/text" android:textSize="18sp" android:paddingTop="24dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="سجل الأحداث" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/log" android:text="لا توجد أحداث." android:textColor="@color/text" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>